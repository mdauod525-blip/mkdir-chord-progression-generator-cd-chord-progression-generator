# Copy to .env (never commit it). Only DATABASE_URL, JWT_SECRET and ENCRYPTION_KEY are required.
DEALBRIDGE_ENVIRONMENT=development
# Supabase / Render / Railway Postgres with PostGIS:
DEALBRIDGE_DATABASE_URL=postgresql+psycopg://dealbridge:dealbridge@localhost:5432/dealbridge
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DEALBRIDGE_JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEALBRIDGE_ENCRYPTION_KEY=
DEALBRIDGE_CORS_ORIGINS=http://localhost:3000
DEALBRIDGE_PUBLIC_APP_URL=http://localhost:3000
# Optional: Supabase Auth JWT secret if you sign users in with Supabase
DEALBRIDGE_SUPABASE_JWT_SECRET=
# Optional: shared rate limiting
DEALBRIDGE_REDIS_URL=

# Claude API (optional; strict caps are set in Admin → AI & automation)
DEALBRIDGE_ANTHROPIC_API_KEY=
DEALBRIDGE_AI_MODEL=claude-opus-5-5
DEALBRIDGE_AI_EFFORT=low

# Email: console (dry run) | resend | sendgrid
DEALBRIDGE_EMAIL_PROVIDER=console
DEALBRIDGE_RESEND_API_KEY=
DEALBRIDGE_SENDGRID_API_KEY=
DEALBRIDGE_EMAIL_FROM=DealBridge AI <deals@yourdomain.com>
DEALBRIDGE_MAILING_ADDRESS=Your Company LLC, 123 Main St, Leesburg VA 20175
# SMS (Twilio) — only sent to investors with recorded SMS consent
DEALBRIDGE_TWILIO_ACCOUNT_SID=
DEALBRIDGE_TWILIO_AUTH_TOKEN=
DEALBRIDGE_TWILIO_FROM_NUMBER=

# Free public-data keys
DEALBRIDGE_CENSUS_API_KEY=
DEALBRIDGE_HUD_API_TOKEN=

# Scheduler process (python -m app.worker)
DEALBRIDGE_SCHEDULER_ENABLED=false
DEALBRIDGE_DAILY_CRON=15 6 * * *
DEALBRIDGE_WEEKLY_CRON=30 7 * * 1

# Optional paid modules (disabled in the free MVP; see docs/DATA_SOURCES.md)
# DEALBRIDGE_ATTOM_API_KEY= DEALBRIDGE_RENTCAST_API_KEY= DEALBRIDGE_PROPERTYRADAR_API_KEY= DEALBRIDGE_RESO_TOKEN=
