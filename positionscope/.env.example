# Copy to .env.local and fill in. All keys are read on the server only — never prefix them with NEXT_PUBLIC_.

# Price data (end-of-day). Leave both empty to run in clearly labelled DEMO mode.
# Tiingo (recommended; free key at https://www.tiingo.com, adjusted EOD prices)
TIINGO_API_KEY=
# Alpha Vantage (fallback prices — unadjusted on the free tier; also forward P/E, PEG, analyst target via OVERVIEW)
ALPHAVANTAGE_API_KEY=

# SEC EDGAR fundamentals (free, no key). SEC requires a descriptive User-Agent with a contact email.
# Leave empty to disable EDGAR fundamentals.
SEC_USER_AGENT=

# Force demo mode even if keys are set: "demo" | "live" (default: live when a price key exists)
DATA_MODE=

# Where the server caches provider responses (default: .cache in the project; use /tmp/positionscope on serverless)
CACHE_DIR=
